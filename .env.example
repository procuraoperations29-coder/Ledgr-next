# ─────────────────────────────────────────────────────────────
# Ledgr environment configuration
# Copy to .env.local and fill in from your Supabase project settings.
# ─────────────────────────────────────────────────────────────

# Supabase — Project Settings › API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. NEVER expose to the browser. Used by the platform-admin
# service-role path and by trusted server actions that bypass RLS.
SUPABASE_SERVICE_ROLE_KEY=

# Public site URL (used for auth redirects, email links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Billing (provider-agnostic abstraction; wire when ready) ──
# Supported providers: paystack | flutterwave
BILLING_PROVIDER=paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=
# Flutterwave webhook secret hash (Settings › Webhooks). Required for webhooks.
FLUTTERWAVE_SECRET_HASH=

# Standard plan price (kobo). ₦3,000 = 300000 kobo.
NEXT_PUBLIC_STANDARD_PLAN_PRICE_KOBO=300000
