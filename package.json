    "@radix-ui/react-slot": "^1.3.1",
    "@radix-ui/react-tabs": "^1.1.2",
    "@react-pdf/renderer": "^4.6.1",
    "@supabase/ssr": "0.5.2",
    "@supabase/supabase-js": "2.45.4",
    "class-variance-authority": "0.7.0",
